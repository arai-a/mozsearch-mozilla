      "objdir_path": "$WORKING/mozilla-beta/objdir",
      "codesearch_path": "$WORKING/mozilla-beta/livegrep.idx",
      "codesearch_ports": [8081, 8181],
      "codesearch_stat": "$WORKING/mozilla-beta/codesearch.json",
      "scip_subtrees": {}
