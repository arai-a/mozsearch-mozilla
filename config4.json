{
  "mozsearch_path": "$MOZSEARCH_PATH",
  "config_repo": "$CONFIG_REPO",
  "instance_type": "t3.2xlarge",

  "trees": {
    "l10n": {
      "priority": 500,
      "on_error": "continue",
      "cache": "codesearch",
      "index_path": "$WORKING/l10n",
      "files_path": "$WORKING/l10n/git",
      "git_path": "$WORKING/l10n/git",
      "git_blame_path": "$WORKING/l10n/blame",
      "github_repo": "https://github.com/mozilla-l10n/firefox-l10n",
      "objdir_path": "$WORKING/l10n/objdir",
      "codesearch_path": "$WORKING/l10n/livegrep.idx",
      "codesearch_ports": [8081, 8181],
      "codesearch_stat": "$WORKING/l10n/codesearch.json",
      "scip_subtrees": {},
      "group": "Other",
      "group_order": 0,
      "help_indexed_langs": ["js"]
    },

    "llvm": {
      "priority": 3,
      "on_error": "continue",
      "cache": "codesearch",
      "index_path": "$WORKING/llvm",
      "files_path": "$WORKING/llvm/git",
      "git_path": "$WORKING/llvm/git",
      "git_blame_path": "$WORKING/llvm/blame",
      "github_repo": "https://github.com/llvm/llvm-project",
      "objdir_path": "$WORKING/llvm/objdir",
      "ignore_missing_path_prefixes": [
        "$WORKING/llvm/objdir/CMakeFiles/CMakeScratch/",
        "$WORKING/llvm/objdir/CMakeFiles/CMakeTmp/"
      ],
      "codesearch_path": "$WORKING/llvm/livegrep.idx",
      "codesearch_ports": [8082, 8182],
      "codesearch_stat": "$WORKING/llvm/codesearch.json",
      "scip_subtrees": {},
      "group": "Other",
      "group_order": 0,
      "label": "LLVM",
      "help_indexed_langs": ["cpp"]
    },

    "mingw": {
